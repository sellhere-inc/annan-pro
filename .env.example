# Public build configuration. All EXPO_PUBLIC_* values are visible to users.
# No demo mode: without Supabase, the sign-in form stays disabled.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# GPay / UPI membership payment, verified manually by an admin.
EXPO_PUBLIC_UPI_ID=
EXPO_PUBLIC_UPI_RECIPIENT=
EXPO_PUBLIC_MEMBERSHIP_AMOUNT=
# Generate with npm run keys:push; use only the PUBLIC key here.
EXPO_PUBLIC_VAPID_PUBLIC_KEY=
# Optional native Expo builds only. Not needed for Safari / Home Screen push.
EXPO_PUBLIC_EAS_PROJECT_ID=
# GOOGLE_SERVICES_JSON=./google-services.json
