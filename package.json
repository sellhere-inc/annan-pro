{
  "name": "annan-pro",
  "version": "2.0.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "test:db": "node tests/database.mjs",
    "keys:push": "node scripts/generate-vapid.mjs",
    "check:production": "node scripts/check-production.mjs",
    "build:production": "npm run check:production && npm run build:web",
    "build:web": "expo export --platform web && node scripts/prepare-web.mjs"
  },
  "dependencies": {
    "@expo/metro-runtime": "~57.0.16",
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@supabase/supabase-js": "^2.0.0",
    "expo": "~57.0.27",
    "expo-constants": "~57.0.21",
    "expo-dev-client": "~57.0.19",
    "expo-device": "~57.0.2",
    "expo-notifications": "~57.0.22",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-url-polyfill": "^4.0.0",
    "react-native-web": "^0.21.2"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@playwright/test": "^1.64.0",
    "@types/node": "^26.6.5",
    "@types/react": "~19.2.2",
    "@types/web-push": "^3.6.4",
    "tsx": "^4.20.0",
    "typescript": "^6.0.3",
    "web-push": "^3.6.7"
  }
}
